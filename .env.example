# Reference only: Railway variables are configured in its dashboard.
# Node does not automatically load this file.
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=/data
AUTO_CONNECT=true
# First boot only: creates the super administrator in the database.
ADMIN_USER=admin
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://your-service.up.railway.app
# PORT is injected by Railway; do not hard-code it.

# Railway runs behind a trusted edge proxy. Set only for that deployment.
TRUST_PROXY=1

# Chromium is installed in the Docker image. Each number uses a separate browser profile.
CHROMIUM_PATH=/usr/bin/chromium
CHROMIUM_NO_SANDBOX=true
# Optional upstream proxy (leave unset on Railway unless required):
# CHROMIUM_PROXY_SERVER=http://proxy.example.com:8080

# Only for one service replica using this data volume: recover old-container Chromium locks.
CHROMIUM_SINGLE_REPLICA=true
